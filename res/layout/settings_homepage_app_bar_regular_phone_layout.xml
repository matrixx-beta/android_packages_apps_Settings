<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:paddingTop="24dp">

    <!-- TITLE + AVATAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/homepage_title"
            style="@style/HomepageTitleText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/settings_label"/>

        <ImageView
            android:id="@+id/account_avatar"
            android:layout_width="@dimen/avatar_length"
            android:layout_height="@dimen/avatar_length"
            android:layout_marginEnd="@dimen/avatar_margin_end"
            android:visibility="invisible"
            android:contentDescription="@string/search_bar_account_avatar_content_description"
            android:accessibilityTraversalAfter="@id/homepage_title"/>
    </LinearLayout>

    <!-- Searchbar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?android:attr/colorBackground"
        android:clickable="false"
        android:focusable="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/search_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:gravity="center_vertical">

            <!-- Search icon -->
            <ImageView
                android:id="@+id/search_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_homepage_search"
                android:tint="@color/top_level_preference_text_color_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Search text -->
            <TextView
                android:id="@+id/search_bar_title"
                style="@style/TextAppearance.SearchBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/search_settings"
                android:textColor="@color/top_level_preference_text_color_primary"
                app:layout_constraintStart_toEndOf="@id/search_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
