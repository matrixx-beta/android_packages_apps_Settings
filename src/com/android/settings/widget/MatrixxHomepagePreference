package com.android.settings.widget;

import android.content.Context;
import android.util.AttributeSet;

import androidx.preference.PreferenceViewHolder;

import com.android.settings.widget.HomepagePreference;

public class MatrixxHomepagePreference extends HomepagePreference {

    private final MatrixxHomepagePreferenceLayoutHelper mHelper;

    public MatrixxHomepagePreference(Context context, AttributeSet attrs) {
        super(context, attrs);
        mHelper = new MatrixxHomepagePreferenceLayoutHelper(this);
    }

    public void setCustomLayoutResource(int layoutResId) {
        mHelper.setCustomLayoutResource(layoutResId);
        notifyChanged(); // Important: refresh the view
    }

    @Override
    public HomepagePreferenceLayoutHelper getHelper() {
        return mHelper;
    }
}

